# protocolo experimental V2 congelado antes de producir datos
PROTOCOL_VERSION=v2
INPUT_RATE_BPS=8500000
HIGH_CAPACITY_PERCENT=140
LOW_CAPACITY_PERCENT=104
LATENCY_MS=160
DELAY_MS=45
LOSS_PERCENT=1
REORDER_PERCENT=0
REORDER_CORRELATION_PERCENT=0
SAMPLE_MS=100
NOMINAL_OHEAD=25

# perfil efectivo usado durante V1; se conserva de forma explícita
QUEUE_LIMIT_PACKETS=151
QUEUE_FORMULA_CAPACITY_PERCENT=112

# afinidad entre núcleos físicos distintos del i5-7Y32
SENDER_CPU=0
RECEIVER_CPU=1

# resultados separados para no modificar la evidencia de V1
V2_RESULTS_SUBDIR=v2
