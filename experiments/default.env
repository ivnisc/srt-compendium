# configuración congelable del experimento
INPUT_RATE_BPS=${INPUT_RATE_BPS:-8500000}
HIGH_CAPACITY_PERCENT=${HIGH_CAPACITY_PERCENT:-140}
LOW_CAPACITY_PERCENT=${LOW_CAPACITY_PERCENT:-112}
SOURCE_RATE_TOLERANCE_PERCENT=${SOURCE_RATE_TOLERANCE_PERCENT:-0.1}
DURATION_S=${DURATION_S:-60}
PHASE_HIGH_S=${PHASE_HIGH_S:-15}
PHASE_LOW_S=${PHASE_LOW_S:-30}
LATENCY_MS=${LATENCY_MS:-120}
DELAY_MS=${DELAY_MS:-45}
LOSS_PERCENT=${LOSS_PERCENT:-1}
REORDER_PERCENT=${REORDER_PERCENT:-10}
REORDER_CORRELATION_PERCENT=${REORDER_CORRELATION_PERCENT:-50}
SAMPLE_MS=${SAMPLE_MS:-100}
NOMINAL_OHEAD=${NOMINAL_OHEAD:-25}
PORT=${PORT:-19000}
INTERFACE=${INTERFACE:-lo}
TOPOLOGY=${TOPOLOGY:-namespace}
NETWORK_NAMESPACE=${NETWORK_NAMESPACE:-srt_rxns}
NAMESPACE_ROOT_IF=${NAMESPACE_ROOT_IF:-srt_tx0}
NAMESPACE_PEER_IF=${NAMESPACE_PEER_IF:-srt_rx0}
NAMESPACE_ROOT_CIDR=${NAMESPACE_ROOT_CIDR:-10.203.0.1/30}
NAMESPACE_PEER_CIDR=${NAMESPACE_PEER_CIDR:-10.203.0.2/30}
NAMESPACE_PEER_IP=${NAMESPACE_PEER_IP:-10.203.0.2}
